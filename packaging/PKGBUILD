# Maintainer: samasadul124-ui
#
# NOTE (E-010 fix): the Arch package name and the upstream archive's top-level
# directory are deliberately decoupled. GitHub tag archives extract to
# "<repo>-<version>" = "cache-cleaner-$pkgver" regardless of pkgname, so
# build()/package() cd into "$srcdir/$_srcrepo-$pkgver" explicitly.

pkgname=cachecleaner
pkgver=0.1.6
pkgrel=1
pkgdesc="Modern, safe cache-cleaning utility (GTK4/libadwaita) for EndeavourOS / Arch Linux"
arch=('any')
url="https://github.com/samasadul124-ui/Arch-cache-cleaner-with-GUI"
license=('GPL-3.0-or-later')
depends=('python' 'python-gobject' 'gtk4' 'libadwaita' 'hicolor-icon-theme')
optdepends=('polkit: clean the root-owned pacman package cache via the isolated helper'
            'pacman-contrib: alternative selective pacman cache retention (paccache)')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
# users who applied the E-010 workaround manually installed 'cache-cleaner';
# replace it cleanly on upgrade
provides=("cache-cleaner=$pkgver")
conflicts=('cache-cleaner')

_srcrepo=Arch-cache-cleaner-with-GUI
source=("$_srcrepo-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# real sha256 of the v$pkgver release tarball (verified at release time).
# Workflow for each release: tag → download tarball → sha256sum → pin here.
sha256sums=('cdd4e21a586bb4b7f2f45f8580bbd80072e382020ff1bb2729035f83f92cedc3')

build() {
  cd "$srcdir/$_srcrepo-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$_srcrepo-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl

  # launcher + icon (menu integration)
  install -Dm644 data/cachecleaner.desktop \
    "$pkgdir/usr/share/applications/cachecleaner.desktop"
  install -Dm644 data/icons/hicolor/scalable/apps/cachecleaner.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cachecleaner.svg"

  # isolated privileged helper for the pacman package cache (rule 7)
  install -Dm755 packaging/cachecleaner-paccache \
    "$pkgdir/usr/bin/cachecleaner-paccache"
  install -Dm644 packaging/io.github.cachecleaner.paccache.policy \
    "$pkgdir/usr/share/polkit-1/actions/io.github.cachecleaner.paccache.policy"

  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
